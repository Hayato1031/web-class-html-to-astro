---
interface Article {
  slug: string;
  title: string;
  date: string;
  displayDate?: string;
  category: string;
  summary: string;
  href?: string;
}
interface Props { articles: Article[]; showHeading?: boolean; cmsOnly?: boolean; }
const { articles, showHeading = true, cmsOnly = false } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const filterId = cmsOnly ? 'cms' : 'all';
---
{showHeading && <div class="section-header"><h2 class="section-title">記事</h2><p class="section-desc">デザインの試行錯誤とWeb制作のノート</p></div>}
<div class="filter-bar" data-filter-id={filterId} aria-label="記事カテゴリ">
  {['すべて', 'お知らせ', 'デザイン', '制作ノート'].map((category, index) => <button class:list={['filter-btn', { active: index === 0 }]} type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-category={category}>{category}</button>)}
</div>
<div class="cms-status" data-cms-status aria-live="polite" hidden></div>
<div class="articles-list" data-articles-list={filterId} data-cms-only={cmsOnly ? 'true' : 'false'}>
  {articles.map((article) => (
    <a class="article-card" data-article-category={article.category} data-article-date={article.date} href={article.href ?? `${base}news/${article.slug}/`}>
      <div class="article-main"><div class="article-meta"><span class="article-category">{article.category}</span><time datetime={article.date}>{article.displayDate ?? article.date}</time></div><h3 class="article-title">{article.title}</h3><p class="article-summary">{article.summary}</p></div><div class="article-arrow" aria-hidden="true">→</div>
    </a>
  ))}
</div>
<script>
  import { cmsArticleCategory, cmsArticleDate, fetchCMSNews, formatCMSDate } from '../lib/microcms';

  const makeCMSCard = (article) => {
    const link = document.createElement('a');
    link.className = 'article-card';
    link.dataset.articleCategory = cmsArticleCategory(article);
    link.dataset.articleDate = cmsArticleDate(article);
    link.href = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/cms-news/detail/?id=${encodeURIComponent(article.id)}`;
    const main = document.createElement('div');
    main.className = 'article-main';
    const meta = document.createElement('div');
    meta.className = 'article-meta';
    const category = document.createElement('span');
    category.className = 'article-category';
    category.textContent = cmsArticleCategory(article);
    const date = document.createElement('time');
    date.dateTime = cmsArticleDate(article);
    date.textContent = formatCMSDate(article);
    meta.append(category, date);
    const title = document.createElement('h3');
    title.className = 'article-title';
    title.textContent = article.title || '無題の記事';
    const summary = document.createElement('p');
    summary.className = 'article-summary';
    summary.textContent = article.summary || '';
    main.append(meta, title, summary);
    const arrow = document.createElement('div');
    arrow.className = 'article-arrow';
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = '→';
    link.append(main, arrow);
    return link;
  };
  const sortCards = (list) => list.append(...[...list.querySelectorAll('[data-article-date]')].sort((a, b) => (b.dataset.articleDate || '').localeCompare(a.dataset.articleDate || '')));
  const applyFilter = (bar, list) => {
    const active = bar.querySelector('[aria-pressed="true"]')?.dataset.category || 'すべて';
    list.querySelectorAll('[data-article-category]').forEach((article) => { article.hidden = active !== 'すべて' && article.dataset.articleCategory !== active; });
  };

  document.querySelectorAll('.filter-bar').forEach((bar) => {
    const list = document.querySelector(`[data-articles-list="${bar.dataset.filterId}"]`);
    bar.addEventListener('click', (event) => {
      const button = event.target.closest('[data-category]');
      if (!button || !list) return;
      bar.querySelectorAll('[data-category]').forEach((item) => {
        const isActive = item === button;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });
      applyFilter(bar, list);
    });
  });

  document.querySelectorAll('[data-articles-list]').forEach(async (list) => {
    const status = list.previousElementSibling;
    const bar = document.querySelector(`[data-filter-id="${list.dataset.articlesList}"]`);
    status.hidden = false;
    status.textContent = 'CMS記事を読み込み中...';
    try {
      const articles = await fetchCMSNews();
      articles.forEach((article) => list.append(makeCMSCard(article)));
      sortCards(list);
      status.hidden = articles.length !== 0 || list.dataset.cmsOnly !== 'true';
      if (articles.length === 0 && list.dataset.cmsOnly === 'true') status.textContent = 'CMS記事はありません。';
      else status.textContent = '';
      if (bar) applyFilter(bar, list);
      const latest = [...articles].sort((a, b) => cmsArticleDate(b).localeCompare(cmsArticleDate(a)))[0];
      const latestLink = document.querySelector('[data-latest-article]');
      if (latest && latestLink && cmsArticleDate(latest) > (latestLink.dataset.latestDate || '')) {
        latestLink.dataset.latestDate = cmsArticleDate(latest);
        latestLink.href = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/cms-news/detail/?id=${encodeURIComponent(latest.id)}`;
        latestLink.querySelector('[data-latest-title]')?.replaceChildren(document.createTextNode(`「${latest.title || '無題の記事'}」`));
      }
    } catch (error) {
      status.hidden = false;
      status.replaceChildren(document.createTextNode(`${error.message} `));
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.className = 'cms-retry-button';
      retry.textContent = '再試行';
      retry.addEventListener('click', () => window.location.reload());
      status.append(retry);
    }
  });
</script>
