---
import Layout from '../../layouts/Layout.astro';
import { cmsArticleCategory, cmsArticleDate, fetchCMSNews, formatCMSDate } from '../../lib/microcms';

export async function getStaticPaths() {
  const articles = await fetchCMSNews();
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
---
<Layout title={`${article.title || 'CMS記事'} - Taro Keio`}>
  <section class="news-detail-page">
    <div class="detail-view active cms-detail">
      <a class="back-btn" href={`${base}cms-news/`}>← CMS記事一覧へ戻る</a>
      <div class="article-meta"><span class="article-category">{cmsArticleCategory(article)}</span><time datetime={cmsArticleDate(article)}>{formatCMSDate(article)}</time></div>
      <h1 class="detail-title">{article.title || '無題の記事'}</h1>
      <p class="article-summary news-summary">{article.summary || ''}</p>
      <div class="detail-body cms-body">{article.body || ''}</div>
    </div>
  </section>
</Layout>
